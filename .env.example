# Mitsinjo Grid — every env var the project uses. Copy to `.env` (root) and fill in.
# Never put real values here. Keep in sync with apps/web/src/lib/env.ts and .mcp.json
# (rule: .claude/rules/maintenance.md).
# Local vs production (Vercel) checklist: docs/setup/env.md

# ── Web server ────────────────────────────
# Port for `make dev` / `pnpm dev` / `pnpm start`, Playwright and `make shots`.
# Read by apps/web/scripts/port.mjs (shell PORT wins over this file). Default 3000.
PORT=3000

# ── Copilot LLM (web app, server-only) ────────
# `make env` copies this file to apps/web/.env.local. Production values live in Vercel (Production env), not here.
# meta | glimmer | mock (mock = offline, no key needed)
LLM_PROVIDER=mock
# Key: dev.meta.ai (Meta Model API). Empty → automatic mock fallback.
META_API_KEY=
# Default muse-spark-1.3 (standard mode: inputs not used for training). Alt: muse-spark-1.2.
META_MODEL=muse-spark-1.3
# Default https://api.meta.ai/v1
META_BASE_URL=
# Local Glimmer (OpenAI-compatible: Ollama http://localhost:11434/v1, vLLM http://localhost:8000/v1).
# Unset → no local step (Meta → mock). Set → Meta → Glimmer → mock, or LLM_PROVIDER=glimmer to lead local.
GLIMMER_BASE_URL=
# Model id served locally. Default muse-glimmer-30b.
GLIMMER_MODEL=muse-glimmer-30b
# Local API key, if the server needs one (Ollama: leave empty).
GLIMMER_API_KEY=
# Perception models (server/perception). Empty → defaults below. Same key and base URL as the chat.
# Voice: POST /asr/transcribe (WAV only). Vision: chat/completions with image parts. Segment: POST /responses.
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_VISION_MODEL=muse-spark-1.3
# 3D final check + re-refinement stage (background). Wonder by default; fails → META_VISION_MODEL.
META_REFINE_MODEL=muse-wonder-1.0
# 3D rubric judge (offline `make shape-judge`, PQ-T4): grades models 1–5 on six criteria. Wonder by default.
META_JUDGE_MODEL=muse-wonder-1.0
# 3D construction-code writer, route B (PQ-T45): writes build() run in the §8bis sandbox. Empty = META_REFINE_MODEL.
# META_CODE_MODEL=muse-wonder-1.0
META_SEGMENT_MODEL=sam-3.1
# 3D kit samples per photo (PQ-T18, read by lib/env.ts): 1 = one call, 2 = two in parallel that vote (≥ 40 s left).
SHAPE_KIT_SAMPLES=1
# Families whose kit call carries the family card (PQ-T13, read by lib/env.ts): comma list of archetypes, e.g. vehicle,house. Empty = none.
SHAPE_KIT_CARD_FAMILIES=
# Muse cards in the 3D stage loop, views check and final check (PQ-T15, read by lib/env.ts): true | false.
SHAPE_LOOP_CARDS=false
# Side views from the Side view card, 2 candidates scored against the front (PQ-T16, read by lib/env.ts): true | false.
SHAPE_SIDE_V2=false
# Meta answer cache (PQ-T49, read by lib/env.ts): true | false. false for agreement evals (a remembered answer is not an independent sample).
SHAPE_CACHE=true
META_IMAGE_MODEL=muse-image-1.0
# Estimated Meta spend allowed per chat session, in USD (catalogue prices). Over it → mock. 0 = no paid calls.
META_SPEND_CAP_USD=15
# true | false. Prefer Spark *-contributor ids (≈ 12× cheaper, Meta trains on inputs/outputs, rate-limited).
# Refused → automatic retry on the standard id. Set false for real (non-simulated) user data.
META_PREFER_CONTRIBUTOR=true

# ── Stitch MCP (Claude Code tooling, not the app) ──
# Read by .mcp.json from the shell environment. `make claude` exports it from .env;
# to export it in a terminal: `source scripts/env.sh` or `eval "$(make -s env-export)"`.
# Key: stitch.withgoogle.com → profile → Stitch settings → API key.
STITCH_API_KEY=


VERCEL_OIDC_TOKEN=

# ── Cloudflare R2 Storage (Media / Images / Canvas) ──
# Guide setup (in French): docs/setup/cloudflare-r2.md
# Account ID: Cloudflare Dashboard -> R2 -> Account Details -> Account ID
R2_ACCOUNT_ID=
# S3 API credentials: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Object Read & Write
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (default mitsinjo-grid-media)
R2_BUCKET_NAME=mitsinjo-grid-media
# Public URL for the bucket (r2.dev subdomain or custom domain)
R2_PUBLIC_URL=

# ── Neon Database (PostgreSQL Chat Sessions) ──
# Optional. Empty → chat sessions, custom scenarios and the dispatch Event Log live in server memory
# (lost on restart). Pooled Neon/Postgres URL, read by the app; tables are created on its first DB call.
DATABASE_URL=

# For uses requiring a connection without pgbouncer (`make db-migrate` prefers it)
DATABASE_URL_UNPOOLED=

# Not read by the app: Vercel–Neon integration leftovers, kept for reference.
# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# ── Scale model bridge (apps/bridge, `make bridge` / `make bridge-sim`) ──
# Local only; read by apps/bridge/src/config.ts. Every var explained in docs/bridge.md.
# Priority: shell > .env.local > .env (this file is a template, never read).
# replay (engine drives the model) | twin (model sensors feed the engine too)
BRIDGE_MODE=twin
# Scenario and strategy the bridge runs (ScenarioId / StrategyId)
BRIDGE_SCENARIO=cloudy_afternoon
BRIDGE_STRATEGY=essential_first
# WebSocket for the web app (default 8787)
BRIDGE_WS_PORT=8787
# true = start an in-process MQTT broker (no Mosquitto needed); false = use MQTT_URL
BRIDGE_EMBEDDED_BROKER=true
MQTT_PORT=1883
# External broker, e.g. mqtt://192.168.4.1:1883 or mqtts://<host>:8883 (default mqtt://localhost:$MQTT_PORT)
MQTT_URL=
# MQTT login (both or none): required by the embedded broker, sent to an external one; same in the firmware
MQTT_USERNAME=
MQTT_PASSWORD=
# ≥ 16 chars (openssl rand -hex 24). Set → only browsers opened with ?bridgeToken=<value> may send cloud/speed
# commands, others are read-only. Empty = open (local only). Secret: put it in .env, never here.
BRIDGE_TOKEN=
# Scale: 1 W model = HW_POWER_SCALE W simulated (4000); 1 simulated hour = HW_TIME_SCALE s at start
# (20; changeable live in the app panel: 60 / 20 / 10 / 5 s)
HW_POWER_SCALE=4000
HW_TIME_SCALE=20
# Lux on the reference sensor under the sun lamp, no cloud (calibrate on site)
HW_LUX_FULL_SUN=20000
# Web app → bridge WebSocket (browser-visible, inlined at build; read by apps/web/src/lib/env.ts publicEnv).
# Empty = panel hidden unless the page is opened with ?bridge=ws://… (deployed site, docs/bridge.md § 8).
# Local: ws://localhost:8787 (restart `make dev` after a change). Empty by default: judges do not need it.
NEXT_PUBLIC_BRIDGE_URL=

# ── Hugging Face dataset (make hf-publish; tooling only, not read by the app) ──
# Token with write permission: huggingface.co/settings/tokens → create, keep secret, never commit.
HF_TOKEN=
# Dataset repo id (namespace/slug). Must match the links in README.md and benchmarks/README.md.
HF_DATASET_REPO=Tokiarivelo/mitsinjo-grid-dispatch-benchmark

# ── Benchmark (make bench, read by packages/engine/src/__tests__/benchmark.test.ts) ──
# Set by the Makefile; only override by hand. BENCH_OUT = report path (unset → no file), BENCH_RUNS = runs per measure.
BENCH_OUT=
BENCH_RUNS=200

# ── Docker Compose (compose.yaml, make docker-up) ──
# Host port mapped to the container's 3000. Default 3000. PORT above is ignored inside the container.
HOST_PORT=3000
